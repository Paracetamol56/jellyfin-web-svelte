{
	"name": "jellyfin-client",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/relative-fallback.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:visual": "VISUAL=1 playwright test --project visual",
		"test:live": "playwright test --project live",
		"lint": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.6",
		"jsdom": "^31.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@jellyfin/sdk": "^1.0.2",
		"@lucide/svelte": "^1.72.0",
		"@tanstack/svelte-query": "^6.4.1",
		"axios": "^1.21.1",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"d3": "^7.9.2",
		"hls.js": "^1.7.4",
		"material-icons": "1.13.14",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2"
	},
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": ">=22"
	}
}
